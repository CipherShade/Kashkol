.data/

# Environment files — only .env.example is committed
.env
.env.local
.env.*.local
.env.development
.env.test

# Test and coverage output
coverage/
test-results/
playwright-report/
.vitest/

# Logs
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backup artifacts (defense in depth — .data/ already excludes .data/backups/;
# BACKUP_DIR overrides or explicit out-paths would put files elsewhere)
*.ksbk
*.ksbk.manifest.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript build info
*.tsbuildinfo
