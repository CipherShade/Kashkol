// Kashkol data model — foundation (M0) plus the core domain schema.
//
// One schema, sectioned per module (ADR-0002). Prisma 7 with the explicit
// `prisma-client` generator output, the PostgreSQL driver adapter, and RLS
// added in the migration (ADR-0006).
//
// Every tenant-scoped table carries a non-null `workspace_id`, an index on it,
// and a row-level-security policy. `src/lib/db/tenant-tables.ts` is the registry
// that CI and the isolation tests agree with.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Locale {
