  availableUntil     DateTime                   @map("available_until") @db.Timestamptz(6)
  durationMinutes    Int                        @default(30) @map("duration_minutes")
  maxAttempts        Int                        @default(1) @map("max_attempts")
  resultVisibility   OnlineExamResultVisibility @default(after_manual_publish) @map("result_visibility")
  resultsPublishedAt DateTime?                  @map("results_published_at") @db.Timestamptz(6)
  maxScore           Decimal                    @default(0) @map("max_score") @db.Decimal(6, 2)
