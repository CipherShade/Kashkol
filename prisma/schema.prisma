  assistant

  @@map("member_role")
}

enum MemberStatus {
  active
  invited
  suspended
  removed

  @@map("member_status")
}

enum PermissionResource {
  students
  grades
  groups
  sessions
  attendance
  homework
  files
  messages
  payments
  exports
  integrations
  settings
  team
  audit
  forms

  @@map("permission_resource")
}

enum InvitationStatus {
  pending
