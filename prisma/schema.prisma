// ---------------------------------------------------------------------------
// Identity — Better Auth owns `user`, `session`, `account`, `verification`.
// Kashkol never adds columns to those tables (DATA_MODEL.md §5.1).
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  preference   UserPreference?
  memberships  WorkspaceMember[]
  auditEvents  AuditEvent[]
  portalGrants PortalGrant[]
  portalPushSubscriptions PortalPushSubscription[]
  platformAdmin PlatformAdmin?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity SessionActivity?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(6)
  createdAt  DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  // Better Auth generates its own opaque id for this table; it is not a UUID.
  id          String @id
  key         String
  count       Int
  lastRequest BigInt @map("last_request")

  @@index([key])
  @@map("rate_limit")
}

/**
 * Per-session activity, so the 12-hour idle timeout can be enforced precisely
 * without adding a column to the Better Auth-owned `session` table.
 */
model SessionActivity {
  sessionId  String   @id @map("session_id")
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_activity")
}

/**
 * Authentication events that happen before a workspace is known. This table is
 * deliberately not tenant-scoped, stores no email address and no raw IP, and is
 * never rendered to a workspace member.
 */
model AuthEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @map("user_id")
  identifierHash String?  @map("identifier_hash")
  event          String
  ipHash         String?  @map("ip_hash")
  userAgentHash  String?  @map("user_agent_hash")
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifierHash, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("auth_event")
}

model UserPreference {
  userId String @id
  locale Locale @default(ar)
  theme  Theme  @default(system)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Workspace {
  id             String          @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String          @unique
  teachingName   String          @map("teaching_name")
  primarySubject String?         @map("primary_subject")
  gradesTaught       String[]            @map("grades_taught")
  status             WorkspaceStatus     @default(active)
  planTier           WorkspacePlanTier   @default(pilot) @map("plan_tier")
  planStatus         WorkspacePlanStatus @default(pilot_active) @map("plan_status")
  planLimitOverrides Json?               @map("plan_limit_overrides")
  planAssignedAt     DateTime?           @map("plan_assigned_at") @db.Timestamptz(6)
  planAssignedBy     String?             @map("plan_assigned_by")
  planNote           String?             @map("plan_note")
  statusReason       String?             @map("status_reason")
  statusUpdatedAt    DateTime?           @map("status_updated_at") @db.Timestamptz(6)
  statusUpdatedBy    String?             @map("status_updated_by")
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings            WorkspaceSettings?
  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  auditEvents         AuditEvent[]
  onboardingTasks     OnboardingTask[]
  students            Student[]
  portalGrants        PortalGrant[]
  portalInvitations   PortalInvitation[]
  portalPushSubscriptions PortalPushSubscription[]
  subjects            Subject[]
  groups              Group[]
  enrollments         Enrollment[]
  teachingSessions    TeachingSession[]
  attendanceMarks     AttendanceMark[]
  attendanceRevisions AttendanceRevision[]
  attendanceTokens    AttendanceToken[]
  sessionRevisions    SessionRevision[]
  assessments         Assessment[]
  assessmentScores    AssessmentScore[]
  payments            Payment[]
  paymentRevisions    PaymentRevision[]
  paymentAdjustments  PaymentAdjustment[]
  feeRules            FeeRule[]
  reportExports       ReportExport[]
  files               File[]
  fileGroups          FileGroupAccess[]
  fileStudents        FileStudentAccess[]
  studentNotes        StudentNote[]
  guardians           Guardian[]
  notifications       Notification[]
  messageOutbox       MessageOutbox[]
  notificationSettings NotificationSettings?
  notificationLogs    NotificationLog[]
  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkResources   HomeworkResource[]
  followUps           StudentFollowUp[]
  followUpEvents      StudentFollowUpEvent[]
  videoLessons        VideoLesson[]
  videoGroupAccesses  VideoGroupAccess[]
  videoStudentAccesses VideoStudentAccess[]
  onlineExams         OnlineExam[]
  onlineExamStudentAssignments OnlineExamStudentAssignment[]
  onlineExamQuestions OnlineExamQuestion[]
  onlineExamAttempts  OnlineExamAttempt[]
  onlineExamResponses OnlineExamResponse[]
  breakGlassGrants    BreakGlassGrant[]
  forms               Form[]
  formSections        FormSection[]
  formQuestions       FormQuestion[]
  formQuestionOptions FormQuestionOption[]
  formLogicRules      FormQuestionLogic[]
  formSubmissions     FormSubmission[]
  formAnswers         FormAnswer[]
  formAnswerFiles     FormAnswerFile[]
  formUploads         FormUpload[]

  @@map("workspace")
}

model WorkspaceSettings {
  workspaceId        String   @id @map("workspace_id") @db.Uuid
  atRiskAfter        Int      @default(2) @map("at_risk_after")
  inactiveAfter      Int      @default(4) @map("inactive_after")
  locale             Locale   @default(ar)
  theme              Theme    @default(system)
  timezone           String   @default("Africa/Cairo")
  currency           String   @default("EGP")
  emailDigestEnabled Boolean  @default(false) @map("email_digest_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@map("workspace_settings")
}

model WorkspaceMember {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  userId      String       @map("user_id")
  role        MemberRole
  status      MemberStatus @default(active)
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime?    @map("removed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  grants    PermissionGrant[]
  ownedFollowUps StudentFollowUp[] @relation("FollowUpOwner")

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_member")
}

model PermissionGrant {
  id          String             @id @default(uuid(7)) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  memberId    String             @map("member_id") @db.Uuid
  resource    PermissionResource
  action      PermissionAction
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // The composite reference makes a grant in workspace A unable to point at a
  // member of workspace B, even if RLS on `workspace_id` alone would allow it.
  member WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([memberId, resource, action])
  @@index([workspaceId])
  @@map("permission_grant")
}

/// A single-use invitation to join a workspace as an assistant.
///
/// Only the SHA-256 hash of the token is stored. The plaintext token exists
/// once, in the message that the configured email transport prepares; it is
/// never written to a log, an audit diff, or an HTTP response.
model WorkspaceInvitation {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  email           String
  role            MemberRole       @default(assistant)
  /** The grant set applied when the invitation is accepted. */
  grants          Json             @default("[]")
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(pending)
  invitedByUserId String           @map("invited_by_user_id")
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  lastSentAt      DateTime         @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?         @map("accepted_by_user_id")
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@map("workspace_invitation")
}

model OnboardingTask {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  key         String
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("onboarding_task")
}

// ---------------------------------------------------------------------------
// Audit — append-only. Written in the same transaction as the mutation.
// ---------------------------------------------------------------------------

model AuditEvent {
  id               String         @id @default(uuid(7)) @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  actorUserId      String?        @map("actor_user_id")
  actorDisplayName String         @map("actor_display_name")
  actorType        AuditActorType @map("actor_type")
  entityType       String         @map("entity_type")
  entityId         String         @map("entity_id")
  action           String
  diff             Json?
  requestId        String         @map("request_id")
  ipHash           String?        @map("ip_hash")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Students & Portal Grants
// ---------------------------------------------------------------------------

model Student {
  id              String    @id @default(uuid(7)) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  grade           String?
  phoneE164       String?   @map("phone_e164")
  parentName      String?   @map("parent_name")
  parentPhoneE164 String?   @map("parent_phone_e164")
  joinedAt        DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  mergedIntoId    String?   @map("merged_into_id") @db.Uuid
  searchKey       String?   @map("search_key")
  phoneticKey     String?   @map("phonetic_key")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  portalGrants        PortalGrant[]
  portalInvitations   PortalInvitation[]
  enrollments         Enrollment[]
  attendanceMarks     AttendanceMark[]
  attendanceRevisions AttendanceRevision[]
  assessmentScores    AssessmentScore[]
  homeworkSubmissions HomeworkSubmission[]
  followUps           StudentFollowUp[]
  payments            Payment[]
  paymentAdjustments  PaymentAdjustment[]
  feeRules            FeeRule[]
  files               File[]
  fileAccesses        FileStudentAccess[]
  notes               StudentNote[]
  guardians           Guardian[]
  notifications       Notification[]
  messageOutbox       MessageOutbox[]
  videoAccesses       VideoStudentAccess[]
  onlineExamAssignments OnlineExamStudentAssignment[]
  onlineExamAttempts  OnlineExamAttempt[]
  formSubmissions     FormSubmission[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("student")
}

// ---------------------------------------------------------------------------
// Guardians (Parents/Authorized Contacts)
// ---------------------------------------------------------------------------

model Guardian {
  id          String          @id @default(uuid(7)) @db.Uuid
  workspaceId String          @map("workspace_id") @db.Uuid
  studentId   String          @map("student_id") @db.Uuid
  firstName   String          @map("first_name")
  lastName    String          @map("last_name")
  relation    GuardianRelation @default(other)
  phoneE164   String          @map("phone_e164")
  email       String?
  isPrimary   Boolean         @default(false) @map("is_primary")
  isAuthorized Boolean        @default(true) @map("is_authorized")
  optOut      Boolean         @default(false) @map("opt_out")
  consentGiven Boolean        @default(false) @map("consent_given")
  consentAt   DateTime?       @map("consent_at") @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  student   Student   @relation(fields: [workspaceId, studentId], references: [workspaceId, id], onDelete: Restrict)
  notifications Notification[]
  messageOutbox MessageOutbox[]
  portalGrants  PortalGrant[]
  portalInvitations PortalInvitation[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, studentId, phoneE164])
  @@index([workspaceId])
  @@index([studentId])
  @@index([phoneE164])
  @@map("guardian")
}

model PortalGrant {
  id           String     @id @default(uuid(7)) @db.Uuid
  workspaceId  String     @map("workspace_id") @db.Uuid
  portalUserId String     @map("portal_user_id")
  studentId    String     @map("student_id") @db.Uuid
  guardianId   String?    @map("guardian_id") @db.Uuid
  kind         PortalKind
  permissions  Json       @default("{}")
  issuedBy     String?    @map("issued_by")
  issuedAt     DateTime   @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  portalUser User      @relation(fields: [portalUserId], references: [id], onDelete: Restrict)
  student    Student   @relation(fields: [workspaceId, studentId], references: [workspaceId, id], onDelete: Restrict)
  guardian   Guardian? @relation(fields: [workspaceId, guardianId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([portalUserId, studentId, kind])
  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([portalUserId])
  @@map("portal_grant")
}

model PortalInvitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  guardianId       String?          @map("guardian_id") @db.Uuid
  kind             PortalKind
  email            String
  permissions      Json             @default("{}")
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(pending)
  issuedByUserId   String           @map("issued_by_user_id")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  lastSentAt       DateTime         @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
