{
  "name": "kashkol",
  "version": "0.1.0",
  "private": true,
  "description": "Kashkol — a multi-tenant workspace for Egyptian private teachers.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run db:generate && next dev -p 3000 -H 0.0.0.0",
    "build": "npm run db:generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "npm run lint:eslint && npm run lint:rules",
    "lint:eslint": "eslint .",
    "lint:rules": "node scripts/check-project-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "vitest run --configLoader native && vitest run --config vitest.ui.config.ts --configLoader native",
    "test:unit": "vitest run --configLoader native",
    "test:ui": "vitest run --config vitest.ui.config.ts --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:integration": "vitest run --config vitest.integration.config.ts --configLoader native",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:dev:start": "node scripts/dev-db.mjs start",
    "db:dev:stop": "node scripts/dev-db.mjs stop",
    "platform-admin": "tsx scripts/platform-admin.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@better-auth/prisma-adapter": "1.7.12",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^7.1.3",
    "@fullcalendar/timegrid": "^6.1.22",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "jsqr": "^1.4.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "6.10.1",
    "pg": "8.23.1",
    "qrcode-generator": "1.4.4",
    "radix-ui": "1.8.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "temporal-polyfill": "^1.0.6",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "embedded-postgres": "17.9.0-beta.16",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@embedded-postgres/windows-x64@17.9.0-beta.17": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.18": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
