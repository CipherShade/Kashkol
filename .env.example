# Kashkol environment configuration
# Copy this file to `.env.local` for local development:
#   Copy-Item .env.example .env.local        (Windows PowerShell)
#   cp .env.example .env.local               (macOS / Linux)
#
# `.env.local` is git-ignored. Never commit real credentials.
# Values below are LOCAL DEVELOPMENT ONLY and grant access to the embedded
# development database started by `npm run db:dev:start`.

# Which environment this process believes it is in: local | staging | production.
# The development seed refuses to run when APP_ENV or NODE_ENV is "production".
APP_ENV=local

# Application (pooled) connection. The application role is NOT the table owner
# and has NO BYPASSRLS, so PostgreSQL row-level security applies to every query.
DATABASE_URL=postgresql://kashkol_app:kashkol_dev_app@localhost:5433/kashkol_dev

# Direct owner connection used by Prisma migrations. The development seed uses
# DATABASE_URL (the application role) so it exercises the same RLS path as the app.
DIRECT_DATABASE_URL=postgresql://kashkol:kashkol_dev@localhost:5433/kashkol_dev

# Better Auth. The secret below is a DEVELOPMENT-ONLY value and must be replaced
# in staging and production with a secret from the platform secret manager.
# Minimum length: 32 characters. Never prefix a secret with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# When "true" (the default), a missing or unreadable migration makes readiness
# fail. Set "false" only for a deliberate diagnostic run; production keeps it true.
REQUIRE_MIGRATIONS=true

# Outbound email for verification and password reset.
#   console -> LOCAL DEVELOPMENT ONLY. The message (including its single-use
#              link) is written to the SERVER CONSOLE. It is never returned in
#              an HTTP response, and the app refuses to start with this value
#              outside APP_ENV=local.
#   none    -> No delivery. Verification and password recovery are disabled and
#              the UI says so. This is the safe default until a provider is
#              selected by an ADR (INTEGRATIONS.md §1.1).
EMAIL_TRANSPORT=console
EMAIL_FROM="Kashkol <no-reply@kashkol.local>"

# Learning-material storage. Local disk is supported only in local development.
FILE_STORAGE_DRIVER=local
FILE_LOCAL_STORAGE_PATH=.data/files
# Optional locally. Staging and production require a random token of at least
# 32 characters for the report-export worker endpoint.
# REPORT_EXPORT_WORKER_TOKEN=

# Non-local environments require an S3-compatible private bucket and ClamAV.
# Use workload identity when available; otherwise set both S3 credentials as
# platform secrets. Never expose these values to the client.
# FILE_STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# Better Auth's database-backed limiter (SECURITY_AND_PRIVACY.md §3.3).
# Omit to use the default: enabled outside local, disabled in local.
# AUTH_RATE_LIMIT_ENABLED=true
